# Скопируйте в .env (cp .env.example .env). Файл .env в git не попадает.
# Все значения необязательны: если переменная не задана, docker-compose.yml
# подставит значение по умолчанию.

POSTGRES_USER=flower
POSTGRES_PASSWORD=flower
POSTGRES_DB=flower_delivery

LOG_LEVEL=INFO

# Службы доставки через запятую. Покупатель видит варианты всех включённых служб.
#   courier — курьер магазина (свой тариф по расстоянию, ключи не нужны) — по умолчанию
#   yandex  — Яндекс Доставка (нужен YANDEX_DELIVERY_TOKEN)
#   cdek    — СДЭК (нужны CDEK_CLIENT_ID и CDEK_CLIENT_SECRET)
#   mock    — заглушка только для тестов
# Пример: DELIVERY_PROVIDERS=courier,yandex,cdek
DELIVERY_PROVIDERS=courier
DELIVERY_TIMEOUT_SECONDS=3

# Токен Яндекс Доставки. Репозиторий публичный: токен только в .env или GitHub Secrets!
YANDEX_DELIVERY_TOKEN=

# СДЭК: тестовая среда https://api.edu.cdek.ru, боевая https://api.cdek.ru. Только в .env!
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_BASE_URL=https://api.cdek.ru
# Код города отправления в справочнике СДЭК (137 — Санкт-Петербург)
CDEK_FROM_CODE=137

# Координаты магазина (точка отправления): долгота и широта
SHOP_LON=30.3141
SHOP_LAT=59.9386

# Секрет подписи JWT-токенов. Для публичного развёртывания задайте свой длинный случайный.
# Репозиторий публичный: настоящий секрет только в .env или GitHub Secrets!
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRE_MINUTES=1440
